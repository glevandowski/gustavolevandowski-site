/*
  Caching strategy:
  - HTML: always revalidate (content + SEO)
  - CSS/JS: one week + SWR (update via deploy)
  - Images/diagrams/brand: long-lived (immutable-ish)
*/

/
  Cache-Control: public, max-age=0, must-revalidate

/en/*
  Cache-Control: public, max-age=0, must-revalidate

/pt/*
  Cache-Control: public, max-age=0, must-revalidate

/llms.txt
  Content-Type: text/markdown; charset=utf-8
  Cache-Control: public, max-age=0, must-revalidate

/.well-known/llms.txt
  Content-Type: text/markdown; charset=utf-8
  Cache-Control: public, max-age=0, must-revalidate

/assets/css/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/assets/js/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/assets/img/*
  Cache-Control: public, max-age=31536000, immutable

/assets/diagrams/*
  Cache-Control: public, max-age=31536000, immutable

/assets/brand/*
  Cache-Control: public, max-age=31536000, immutable
